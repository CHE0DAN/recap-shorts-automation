 "captions": [
  {
   "text": "가게를 고치던 목수가",
   "start": 3.156,
   "end": 4.3574,
   "emphasis": null
  },
  {
   "text": "벽 안에서 먼지 묻은",
   "start": 4.3574,
   "end": 5.4086,
   "emphasis": null
  },
  {
   "text": "봉투 하나를 꺼냈대.",
   "start": 5.4086,
   "end": 6.4598,
   "emphasis": null
  },
  {
   "text": "삼십 년 된 봉투였어.",
   "start": 6.4598,
   "end": 7.511,
   "emphasis": "삼십 년"
  },
  {
   "text": "봉투엔 우표도 없이",
   "start": 7.611,
   "end": 9.0985,
   "emphasis": "우표도"
  },
  {
   "text": "이름과 지금은 없는",
   "start": 9.0985,
   "end": 10.2885,
   "emphasis": null
  },
  {
   "text": "골목 이름만 적혀 있었대.",
   "start": 10.2885,
   "end": 11.776,
   "emphasis": null
  },
  {
   "text": "가게 주인은 동네를",
   "start": 11.876,
   "end": 12.9551,
   "emphasis": null
  },
  {
   "text": "돌며 그 이름을 물었고,",
   "start": 12.9551,
   "end": 14.0343,
   "emphasis": null
  },
  {
   "text": "마침 두 집 건너에",
   "start": 14.0343,
   "end": 15.4217,
   "emphasis": "두 집 건너"
  },
  {
   "text": "그 사람이 살았대.",
   "start": 15.4217,
   "end": 16.655,
   "emphasis": null
  },
  {
   "text": "편지는 그 사람이",
   "start": 16.755,
   "end": 17.8575,
   "emphasis": null
  },
  {
   "text": "이사를 떠나던 날",
   "start": 17.8575,
   "end": 19.1175,
   "emphasis": null
  },
  {
   "text": "새벽녘에 어머니가 밤새",
   "start": 19.1175,
   "end": 20.3775,
   "emphasis": "새벽녘"
  },
  {
   "text": "써 둔 것이었대.",
   "start": 20.3775,
   "end": 21.48,
   "emphasis": null
  },
  {
   "text": "편지에는 미안하다는",
   "start": 21.58,
   "end": 22.3572,
   "emphasis": null
  },
  {
   "text": "말과 함께 오래된",
   "start": 22.3572,
   "end": 23.1344,
   "emphasis": null
  },
  {
   "text": "가족사진 한 장이",
   "start": 23.1344,
   "end": 24.1707,
   "emphasis": "가족사진"
  },
  {
   "text": "들어 있었대.",
   "start": 24.1707,
   "end": 25.207,
   "emphasis": null
  },
  {
   "text": "그 사람은 편지를",
   "start": 25.307,
   "end": 26.0568,
   "emphasis": null
  },
  {
   "text": "다 읽고도 한참 동안",
   "start": 26.0568,
   "end": 27.4065,
   "emphasis": null
  },
  {
   "text": "아무 말도 못 하고",
   "start": 27.4065,
   "end": 28.6063,
   "emphasis": null
  },
  {
   "text": "그냥 울었다고 했어.",
   "start": 28.6063,
   "end": 29.806,
   "emphasis": "울었다고"
  },
  {
   "text": "삼십 년 된 편지가 이제야",
   "start": 29.906,
   "end": 31.4844,
   "emphasis": null
  },
  {
   "text": "제자리를 찾은 거였지?",
   "start": 31.4844,
   "end": 32.905,
   "emphasis": null
  }
 ],
